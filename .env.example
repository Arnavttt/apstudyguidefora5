# Five & A+ — AI Question Stream · environment example
# Copy to .env.local (git-ignored) and adjust. Every value below is OPTIONAL:
# with none set, the site still works using the built-in seeded question bank.
#
# These are SERVER-SIDE ONLY (read by api/question.js + api/chat.js via
# serve-local.mjs or your Worker/edge host). They are NEVER exposed to the browser.

# ── Provider selection ───────────────────────────────────────────────────────
# ollama   → local Ollama first, then seeded fallback (recommended, free, private)
# auto     → Ollama if reachable, then Anthropic, then OpenAI, then seeded fallback
# fallback → seeded local questions only (no AI calls at all)
# anthropic / openai → force a specific cloud provider (needs the matching key)
AI_QUESTION_PROVIDER=ollama

# ── Local Ollama (https://ollama.com) ────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EVALUATOR_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=60000

# Set to 1 ONLY if you deliberately point OLLAMA_BASE_URL at a non-localhost
# host you control. Left unset, the server refuses remote Ollama URLs (SSRF guard).
# QS_ALLOW_REMOTE_OLLAMA=

# ── Optional paid providers (leave blank to disable) ─────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Legacy aliases (still honored; prefer the names above) ───────────────────
# QS_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# QS_OLLAMA_MODEL=llama3.2
# QS_ANTHROPIC_MODEL=claude-sonnet-4-6
# QS_OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of browser origins allowed to call the AI endpoints.
# localhost is always allowed. Set this to your production origin when deploying.
# QS_ALLOWED_ORIGINS=https://your-site.example
