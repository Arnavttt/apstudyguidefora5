# Claude worktrees — never commit these as submodules
.claude/worktrees/

# ── Secrets / env (NEVER commit) ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.*
!.env.example

# ── Dependencies / build output ──────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.vercel/
.wrangler/

# ── Local AI / agent runtime state (not part of the site) ────────────────────
# ruflo / claude-flow scaffolding + local databases dropped into the tree.
.claude-flow/
.swarm/
.mcp.json
ruvector.db
*.db
.claude/memory.db
.claude/settings.json
.claude/settings.json.*.bak
.claude/agents/
.claude/commands/
.claude/helpers/
# Ignore ruflo's generic skill dump, but SHIP the project-authored skills below.
.claude/skills/*
!.claude/skills/qstream-course-authoring/
!.claude/skills/legal-safety-review/
!.claude/skills/secure-secrets-ai-provider/
